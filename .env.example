# Local development defaults. Copy to .env.local and update if needed.
DATABASE_URL="postgresql://logria:logria@localhost:5432/logria?schema=public"
NEXT_PUBLIC_LOGRIA_APP_URL="http://localhost:3000/app"
LOGRIA_DEMO_MODE="true"

# Optional real connector credentials (server-side only)
METABASE_BASE_URL=""
METABASE_API_KEY=""
POSTHOG_BASE_URL="https://us.posthog.com"
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
SENTRY_BASE_URL="https://sentry.io"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
STRIPE_SECRET_KEY=""
STRIPE_BASE_URL="https://api.stripe.com"
CHATWOOT_BASE_URL=""
CHATWOOT_API_ACCESS_TOKEN=""
CHATWOOT_ACCOUNT_ID=""

# Optional real AI provider mode. Leave as demo for no-key local quickstart.
LOGRIA_AI_MODE="demo"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
AUTH_SECRET="change-me-in-production"
